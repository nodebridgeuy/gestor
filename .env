# Copia este archivo como ".env" y ajusta los valores.
# En Render NO se sube el .env: esas mismas claves se cargan como variables de entorno.

# --- Base de datos (valores por defecto de XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portal_informativo
DB_USER=root
DB_PASS=
DB_SSL=0

# --- Clave que usa el gestor para hablar con el portal (poner una larga y secreta) ---
API_KEY=1

# --- Opcionales ---
ALLOWED_ORIGIN=*
UPLOADS_DIR=
MAX_UPLOAD_MB=10
TRUST_PROXY=0
IP_SALT=cambiar-esto
RATE_LIMIT_MAX=5
RATE_LIMIT_MINUTES=10
